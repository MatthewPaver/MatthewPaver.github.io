{
  "name": "matthew-paver-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 4321 --directory store",
    "build": "node scripts/validate-store.mjs && node scripts/prepare-pages-artifact.mjs",
    "preview": "python3 -m http.server 4321 --directory pages-dist",
    "test": "npm run test:unit && npm run build",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0"
  }
}
