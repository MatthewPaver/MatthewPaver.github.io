{
  "name": "matthew-paver-product-store",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "metrics": "node scripts/fetch-github-metrics.mjs",
    "screenshots": "node scripts/capture-product-screenshots.mjs",
    "test": "npm run test:unit && npm run build",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run metrics && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "^1.62.0",
    "typescript": "^5.9.3"
  }
}
