---
import type { AppEntry } from "../lib/catalogue";
import { appUrl } from "../lib/catalogue";

interface Props {
  app: AppEntry;
}

const { app } = Astro.props;
const data = app.data;
const detailUrl = appUrl(app);
const demoUrl = data.launch ?? data.repo ?? detailUrl;
const actionLabel = data.launch ? "Live demo" : data.repo ? "Source" : "Case notes";
const statusTag = data.launch
  ? "Live"
  : data.repo
    ? "Public repo"
    : "Private";
const isArchived = data.version === "Archived";
---

<article class="product-card" data-portfolio-entry data-shelf={data.shelf}>
  <a class="product-preview" href={demoUrl} aria-label={`Open ${data.title}`}>
    <picture>
      {data.imageAvif && <source srcset={data.imageAvif} type="image/avif" />}
      <img
        src={data.image}
        alt={data.imageAlt}
        width="1200"
        height="675"
        loading="lazy"
      />
    </picture>
  </a>

  <div class="product-card-body">
    <p class="project-label">
      <span class:list={["shelf-tag", isArchived ? "shelf-tag--archived" : `shelf-tag--${data.launch ? "live" : data.repo ? "public" : "private"}`]}>{isArchived ? "Archived" : statusTag}</span>
      {data.category}{data.since && ` · since ${data.since}`}
    </p>
    <h3><a href={detailUrl}>{data.shortTitle ?? data.title}</a></h3>
    <p class="product-summary">{data.tagline}</p>
    <div class="product-actions">
      <a href={demoUrl}>{actionLabel} <span aria-hidden="true">↗</span></a>
      <a href={detailUrl}>Build notes</a>
    </div>
  </div>
</article>
