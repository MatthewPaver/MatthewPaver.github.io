---
import type { AppEntry } from "../lib/catalogue";
import { appUrl, displayDate, metricFor, searchableText } from "../lib/catalogue";

interface Props {
  app: AppEntry;
  featured?: boolean;
}

const { app, featured = false } = Astro.props;
const data = app.data;
const metric = metricFor(app);
const statusLabel = {
  live: "Live app",
  public: "Open source",
  prototype: "Prototype",
  private: "Protected case",
}[data.status];
const actionUrl = data.launch ?? data.repo ?? data.caseStudy ?? appUrl(app);
---

<article
  class:list={["app-card", featured && "app-card--featured"]}
  data-catalogue-item
  data-kind={data.kind}
  data-status={data.status}
  data-stack={data.stack.join("|").toLowerCase()}
  data-search={searchableText(app)}
  data-updated={(metric?.updatedAt ?? data.updated).toString()}
>
  <a class="app-media" href={appUrl(app)} aria-label={`View ${data.title} details`}>
    <picture>
      {data.imageAvif && <source srcset={data.imageAvif} type="image/avif" />}
      <img
        src={data.image}
        alt={data.imageAlt}
        width="1200"
        height="675"
        loading={featured ? "eager" : "lazy"}
        fetchpriority={featured ? "high" : "auto"}
      />
    </picture>
    <span class="media-corner" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9" /></svg>
    </span>
  </a>
  <div class="app-card-body">
    <div class="badge-row">
      <span class:list={["badge", `badge--${data.status}`]}>{statusLabel}</span>
      {metric?.ciStatus === "success" && <span class="badge badge--verified">Checks passing</span>}
      {metric?.ciStatus === "failure" && <span class="badge badge--warning">Checks need attention</span>}
    </div>
    <div class="app-title-row">
      <div>
        <p class="eyebrow">{data.category}</p>
        <h3><a href={appUrl(app)}>{data.shortTitle ?? data.title}</a></h3>
      </div>
      <span class="updated">{displayDate(metric?.updatedAt ?? data.updated)}</span>
    </div>
    <p class="app-tagline">{data.tagline}</p>
    <ul class="proof-list" aria-label={`${data.title} proof points`}>
      {data.proof.slice(0, featured ? 3 : 2).map((item) => <li>{item}</li>)}
    </ul>
    <ul class="stack-list" aria-label={`${data.title} technology`}>
      {data.stack.slice(0, 4).map((item) => <li>{item}</li>)}
    </ul>
    <div class="card-actions">
      <a class="button button--primary" href={actionUrl}>{data.primaryAction}</a>
      <a class="text-link" href={appUrl(app)}>Details <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
