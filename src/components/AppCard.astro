---
import AppIcon from "./AppIcon.astro";
import type { AppEntry } from "../lib/catalogue";
import { appUrl, displayDate, metricFor, searchableText } from "../lib/catalogue";

interface Props {
  app: AppEntry;
  priority?: boolean;
}

const { app, priority = false } = Astro.props;
const data = app.data;
const metric = metricFor(app);
const detailUrl = appUrl(app);
const actionUrl =
  data.kind === "case-study" ? (data.launch ?? detailUrl) : (data.launch ?? data.repo ?? detailUrl);
const statusLabel = {
  live: "Runs in browser",
  public: "Source available",
  prototype: "Private prototype",
  private: data.launch ? "Seeded demo" : "Case study",
}[data.status];
const actionLabel = {
  live: "Open app",
  public: "View source",
  prototype: "View overview",
  private: data.launch ? "Open demo" : "View case study",
}[data.status];
---

<article
  class="product-card"
  data-catalogue-item
  data-kind={data.kind}
  data-status={data.status}
  data-source={Boolean(data.repo)}
  data-stack={data.stack.join("|").toLowerCase()}
  data-search={searchableText(app)}
  data-updated={(metric?.updatedAt ?? data.updated).toString()}
>
  <a class="product-preview" href={detailUrl} aria-label={`View ${data.title} details`}>
    <picture>
      {data.imageAvif && <source srcset={data.imageAvif} type="image/avif" />}
      <img
        src={data.image}
        alt={data.imageAlt}
        width="1200"
        height="675"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
      />
    </picture>
    <span>View preview</span>
  </a>

  <div class="product-card-body">
    <div class="product-identity">
      <AppIcon slug={app.id} />
      <div>
        <p>{data.category}</p>
        <h3><a href={detailUrl}>{data.shortTitle ?? data.title}</a></h3>
      </div>
    </div>

    <p class="product-summary">{data.tagline}</p>

    <div class="product-owner">
      <span class="owner-mark" aria-hidden="true">MP</span>
      <span>Matthew Paver</span>
    </div>

    <div class="product-meta">
      <span class:list={["availability", `availability--${data.status}`]}>{statusLabel}</span>
      <span>{metric?.release ?? data.version}</span>
      <time datetime={(metric?.updatedAt ?? data.updated).toString()}>
        {displayDate(metric?.updatedAt ?? data.updated)}
      </time>
    </div>

    <div class="product-actions">
      <a class="product-action" href={actionUrl}>{actionLabel}<span aria-hidden="true">↗</span></a>
      <a class="product-details" href={detailUrl}>Details</a>
    </div>
  </div>
</article>
