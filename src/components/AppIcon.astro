---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<span class="app-icon" data-app={slug} aria-hidden="true">
  {slug === "projectlens" && (
    <svg viewBox="0 0 24 24"><path d="M3 12s3.4-5 9-5 9 5 9 5-3.4 5-9 5-9-5-9-5Z" /><circle cx="12" cy="12" r="2.4" /></svg>
  )}
  {slug === "meetingproof" && (
    <svg viewBox="0 0 24 24"><path d="M6 3.5h9l3 3V20.5H6Z" /><path d="M15 3.5v4h3M9 12h6M9 16h4" /></svg>
  )}
  {slug === "output-gate" && (
    <svg viewBox="0 0 24 24"><path d="m8 4-4 8 4 8M16 4l4 8-4 8M9.5 12l1.7 1.7 3.5-4" /></svg>
  )}
  {slug === "decisiongraph" && (
    <svg viewBox="0 0 24 24"><path d="m7 7 5 5m0 0 5-6m-5 6 5 5" /><circle cx="6" cy="6" r="2.5" /><circle cx="12" cy="12" r="2.5" /><circle cx="18" cy="5" r="2.5" /><circle cx="18" cy="18" r="2.5" /></svg>
  )}
  {slug === "marketing-ml-lakehouse" && (
    <svg viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4Z" /><path d="m4 12 8 4 8-4M4 17l8 4 8-4" /></svg>
  )}
  {slug === "paper-trading" && (
    <svg viewBox="0 0 24 24"><path d="M4 19V5M4 19h16M7 15l4-4 3 2 5-7" /></svg>
  )}
  {slug === "winchester-buyer-check" && (
    <svg viewBox="0 0 24 24"><path d="m3.5 11 8.5-7 8.5 7M6 9.5V20h12V9.5M10 20v-6h4v6" /></svg>
  )}
  {slug === "happening" && (
    <svg viewBox="0 0 24 24"><path d="M12 21s6-5.6 6-11a6 6 0 1 0-12 0c0 5.4 6 11 6 11Z" /><circle cx="12" cy="10" r="2" /></svg>
  )}
</span>
