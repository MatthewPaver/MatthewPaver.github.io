---
import type { AppEntry } from "../lib/catalogue";
import { appUrl } from "../lib/catalogue";

interface Props {
  apps: AppEntry[];
}
const { apps } = Astro.props;
---

<dialog class="command-dialog" aria-labelledby="command-title">
  <div class="command-shell">
    <header>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.4A7.75 7.75 0 1 1 3.5 11.25a7.75 7.75 0 0 1 15.5 0Z" /></svg>
      <label class="sr-only" for="command-search">Search products</label>
      <input id="command-search" type="search" placeholder="Search products and technology…" autocomplete="off" />
      <button class="command-close" type="button" aria-label="Close search">Esc</button>
    </header>
    <div class="command-results" role="listbox" aria-labelledby="command-title">
      <p id="command-title" class="command-label">Products and case studies</p>
      {apps.map((app) => (
        <a
          href={appUrl(app)}
          role="option"
          data-command-item
          data-search={[app.data.title, app.data.category, ...app.data.stack].join(" ").toLowerCase()}
        >
          <span>
            <strong>{app.data.title}</strong>
            <small>{app.data.category} · {app.data.stack.slice(0, 3).join(" · ")}</small>
          </span>
          <span aria-hidden="true">↵</span>
        </a>
      ))}
      <p class="command-empty" hidden>No matching product. Try a technology or problem.</p>
    </div>
  </div>
</dialog>
