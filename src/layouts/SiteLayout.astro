---
import "@fontsource-variable/ibm-plex-sans";
import "@fontsource-variable/newsreader";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/assets/og-store.png",
  canonical = Astro.url.pathname,
  structuredData,
} = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eeeae0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111816" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Matthew Paver Product Store" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content="Matthew Paver product store" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const savedTheme = localStorage.getItem("mp-theme");
        if (savedTheme === "light" || savedTheme === "dark") {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch {}
    </script>
    {structuredData && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Matthew Paver product store home">
          <span class="brand-mark" aria-hidden="true">MP</span>
          <span>
            <strong>Product Store</strong>
            <small>Useful software, with evidence</small>
          </span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          <a href="/#products">Products</a>
          <a href="/#case-studies">Case studies</a>
          <a href="/#method">Method</a>
        </nav>
        <div class="header-actions">
          <button class="icon-button command-trigger" type="button" aria-label="Search products" title="Search products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.4A7.75 7.75 0 1 1 3.5 11.25a7.75 7.75 0 0 1 15.5 0Z" /></svg>
            <kbd>⌘K</kbd>
          </button>
          <button class="icon-button theme-toggle" type="button" aria-label="Switch colour theme" title="Switch colour theme">
            <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5" /><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
            <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.1A8.5 8.5 0 0 1 8.9 3.5 8.5 8.5 0 1 0 20.5 15.1Z" /></svg>
          </button>
          <a class="header-github" href="https://github.com/MatthewPaver">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <strong>Matthew Paver</strong>
          <p>Automation, project evidence, data systems and practical AI workflow tools.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href="/">Product store</a>
          <a href="https://github.com/MatthewPaver">GitHub</a>
          <a href="https://www.linkedin.com/in/matthew-paver-534262166/">LinkedIn</a>
        </nav>
        <p class="footer-note">No invented ratings. No hidden uploads. Product boundaries are stated on every page.</p>
      </div>
      <div class="shell footer-bottom">
        <span>© 2026 Matthew Paver</span>
        <span>Static site · no cookies · no tracking</span>
      </div>
    </footer>
    <script>
      const themeButton = document.querySelector(".theme-toggle");
      themeButton?.addEventListener("click", () => {
        const current =
          document.documentElement.dataset.theme ??
          (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("mp-theme", next);
        } catch {}
      });
    </script>
  </body>
</html>
