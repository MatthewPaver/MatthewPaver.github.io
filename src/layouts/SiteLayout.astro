---
import "@fontsource-variable/manrope";
import "@fontsource-variable/newsreader";
import "@fontsource/dm-mono/400.css";
import "@fontsource/dm-mono/500.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/assets/og-store.png",
  canonical = Astro.url.pathname,
  structuredData,
} = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ebe8df" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Matthew Paver" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content="Software projects by Matthew Paver" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    {structuredData && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Matthew Paver home">
          <span class="brand-mark" aria-hidden="true">MP</span>
          <span>
            <strong>Matthew Paver</strong>
            <small>Product engineer</small>
          </span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          <a href="/#work">Work</a>
          <a href="/#catalogue">All work</a>
          <a href="/#about">About</a>
        </nav>
        <div class="header-actions">
          <a class="header-github" href="https://github.com/MatthewPaver">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-bar">
        <strong>Matthew Paver</strong>
        <nav aria-label="Footer navigation">
          <a href="/#work">Work</a>
          <a href="/#catalogue">All work</a>
          <a href="https://github.com/MatthewPaver">GitHub</a>
          <a href="https://www.linkedin.com/in/matthew-paver-534262166/">LinkedIn</a>
          <a href="https://github.com/MatthewPaver/MatthewPaver/blob/main/CV.pdf">CV</a>
        </nav>
        <span>© 2026</span>
      </div>
    </footer>
  </body>
</html>
