---
import { getCollection } from "astro:content";
import AppCard from "../components/AppCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { appUrl, sortApps } from "../lib/catalogue";

const apps = sortApps(await getCollection("apps"));
const featuredApps = apps.filter((app) => app.data.featured);
const otherApps = apps.filter((app) => !app.data.featured);
const liveCount = apps.filter((app) => app.data.launch).length;

const featuredCopy: Record<string, string> = {
  projectlens:
    "Compare the dates in a change pack with the schedule behind it. The demo shows the three largest conflicts and lets you record the board's response.",
  meetingproof:
    "Paste in labelled meeting notes, review the decisions and actions, then export the agreed follow-up.",
  "output-gate":
    "Check generated text for wording that must be present and claims that must not appear. It runs in the browser and in CI.",
};

const shelves = [
  { key: "all", label: "All" },
  { key: "product", label: "Product" },
  { key: "data-ml", label: "Data & ML" },
  { key: "analytics", label: "Analytics" },
  { key: "automation", label: "Automation" },
];

const credentials = [
  { name: "AWS Cloud Practitioner", issuer: "Amazon Web Services" },
  { name: "AWS AI Practitioner", issuer: "Amazon Web Services" },
  { name: "Neo4j Certified Professional", issuer: "Neo4j" },
  { name: "AI Agents Fundamentals", issuer: "Hugging Face" },
  { name: "RPA Developer Foundation", issuer: "UiPath" },
  { name: "Diploma in IT", issuer: "BCS" },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Matthew Paver",
    url: "https://matthewpaver.github.io/",
    sameAs: [
      "https://github.com/MatthewPaver",
      "https://www.linkedin.com/in/matthew-paver-534262166/",
    ],
    jobTitle: "Product engineer",
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Software projects by Matthew Paver",
    numberOfItems: apps.length,
    itemListElement: apps.map((app, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: app.data.title,
      url: new URL(appUrl(app), Astro.site).href,
    })),
  },
];
---

<SiteLayout
  title="Matthew Paver · Product engineer"
  description="Software for messy, real-world work: project delivery, operations, data and applied AI — by Matthew Paver."
  structuredData={structuredData}
>
  <section class="portfolio-intro shell">
    <div class="portfolio-name">
      <p class="kicker">Product engineer</p>
      <h1>Matthew Paver</h1>
      <p class="portfolio-stats" aria-label="Portfolio at a glance">
        {apps.length} products &amp; studies · {liveCount} live demos · shipping publicly since 2017
      </p>
    </div>
    <div class="portfolio-intro-copy">
      <p class="portfolio-lede">
        I build software for messy, real-world work: comparing a project pack,
        turning meeting notes into actions, checking AI output before release.
      </p>
      <dl class="spec-strip">
        <div><dt>Focus</dt><dd>Human-in-the-loop decision tools</dd></div>
        <div><dt>Based</dt><dd>London</dd></div>
        <div><dt>Now</dt><dd>ProjectLens change assurance · agent-reviewed trading research</dd></div>
      </dl>
      <nav class="portfolio-links" aria-label="Matthew Paver links">
        <a href="https://github.com/MatthewPaver">GitHub <span aria-hidden="true">↗</span></a>
        <a href="https://www.linkedin.com/in/matthew-paver-534262166/">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/MatthewPaver/MatthewPaver/blob/main/CV.pdf">CV (PDF) <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </section>

  <section id="work" class="selected-work">
    <div class="shell">
      <header class="portfolio-section-heading">
        <div>
          <p class="kicker">Work</p>
          <h2>Selected projects</h2>
        </div>
        <p>These are the three I would open first.</p>
      </header>

      <div class="featured-projects">
        {featuredApps.map((app, index) => {
          const data = app.data;
          const detailUrl = appUrl(app);
          const demoUrl = data.launch ?? data.repo ?? detailUrl;
          return (
            <article
              class:list={["featured-project", index === 0 && "featured-project--lead"]}
              data-portfolio-entry
            >
              <a class="featured-project-media" href={demoUrl} aria-label={`Open ${data.title}`}>
                <picture>
                  {data.imageAvif && <source srcset={data.imageAvif} type="image/avif" />}
                  <img
                    src={data.image}
                    alt={data.imageAlt}
                    width="1200"
                    height="675"
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                  />
                </picture>
              </a>
              <div class="featured-project-copy">
                <p class="project-label">0{index + 1} / {data.category}{data.since && ` · since ${data.since}`}</p>
                <h3><a href={detailUrl}>{data.title}</a></h3>
                <p>{featuredCopy[app.id]}</p>
                <div class="project-links">
                  <a href={demoUrl}>Open demo <span aria-hidden="true">↗</span></a>
                  <a href={detailUrl}>Build notes</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="case-strip">
    <div class="shell">
      <header class="portfolio-section-heading">
        <div>
          <p class="kicker">Featured build</p>
          <h2>Happening: messy venue pages into checked event data.</h2>
        </div>
        <p>One build end to end — the pattern behind most of this shelf.</p>
      </header>
      <div class="case-grid">
        <div><h3>Problem</h3><p>Event listings are scattered, inconsistent and easy to break.</p></div>
        <div><h3>Decision</h3><p>Treat each venue as a configured source with explicit extraction rules.</p></div>
        <div><h3>Result</h3><p>103+ source configs, dedupe and checks, scheduled runs, and a 167-test reliability suite.</p></div>
        <div><h3>What stuck</h3><p>Scraping only helps when you can see exactly why a run failed.</p></div>
      </div>
      <div class="case-actions">
        <a class="button button--primary" href="https://matthewpaver.github.io/happening-open-core/">Open the evidence workbench</a>
        <a class="button button--secondary" href="/store/apps/happening/">Read the build notes</a>
      </div>
    </div>
  </section>

  <section id="more-work" class="more-work">
    <div class="shell">
      <header class="portfolio-section-heading">
        <div>
          <p class="kicker">The full shelf</p>
          <h2>Everything else I have built</h2>
        </div>
        <p>Public repos, private products and archived experiments — filter by the kind of work.</p>
      </header>

      <div class="shelf-filters" role="group" aria-label="Filter projects" hidden>
        {shelves.map((shelf, index) => (
          <button
            type="button"
            data-chip={shelf.key}
            aria-pressed={index === 0 ? "true" : "false"}
          >{shelf.label}</button>
        ))}
      </div>

      <div class="product-grid" data-shelf-grid>
        {otherApps.map((app) => <AppCard app={app} />)}
      </div>
    </div>
  </section>

  <section class="credentials-strip">
    <div class="shell">
      <header class="portfolio-section-heading">
        <div>
          <p class="kicker">Credentials</p>
          <h2>Certifications behind the build work.</h2>
        </div>
        <p>Verification links live in the <a href="https://github.com/MatthewPaver">GitHub profile</a> and <a href="https://github.com/MatthewPaver/MatthewPaver/blob/main/CV.pdf">CV</a>.</p>
      </header>
      <ul class="credential-grid">
        {credentials.map((credential) => (
          <li><strong>{credential.name}</strong><span>{credential.issuer}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="about" class="portfolio-about shell">
    <p class="kicker">About</p>
    <div>
      <h2>A bit about me</h2>
      <p>
        I work across product design, software, data and automation. Most of these
        projects started because I wanted to understand a problem by building the
        tool myself. The code, tests and known limits are in the linked repositories.
      </p>
      <nav class="portfolio-links" aria-label="Contact Matthew Paver">
        <a href="https://www.linkedin.com/in/matthew-paver-534262166/">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/MatthewPaver">GitHub <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/MatthewPaver/MatthewPaver/blob/main/CV.pdf">CV (PDF) <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </section>

  <script>
    const filterBar = document.querySelector<HTMLElement>(".shelf-filters");
    if (filterBar) {
      filterBar.hidden = false;
      const chips = [...filterBar.querySelectorAll<HTMLButtonElement>("[data-chip]")];
      const cards = [...document.querySelectorAll<HTMLElement>("[data-shelf-grid] [data-shelf]")];
      for (const chip of chips) {
        chip.addEventListener("click", () => {
          const key = chip.dataset.chip;
          for (const other of chips) other.setAttribute("aria-pressed", String(other === chip));
          for (const card of cards) card.hidden = key !== "all" && card.dataset.shelf !== key;
        });
      }
    }
  </script>
</SiteLayout>
