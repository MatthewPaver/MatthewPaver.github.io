---
import { getCollection } from "astro:content";
import AppCard from "../components/AppCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { appUrl, sortApps } from "../lib/catalogue";

const apps = sortApps(await getCollection("apps"));
const featuredApps = apps.filter((app) => app.data.featured);
const supportingApps = apps.filter((app) => !app.data.featured && app.data.tier === "supporting");
const listedApps = apps.filter((app) => app.data.tier === "listed");

const situations: Record<string, { prompt: string; finish: string }> = {
  projectlens: {
    prompt: "A project change needs a board decision.",
    finish: "The three largest conflicts between the pack and its schedule, their source dates, and a recorded board response you can export.",
  },
  meetingproof: {
    prompt: "Meeting notes need an accountable follow-up.",
    finish: "A reviewed register of decisions, actions, owners and open questions — every item pinned to its source line.",
  },
  "output-gate": {
    prompt: "An AI workflow changed before release.",
    finish: "A pass or block result against required and banned wording, in the browser or as a CI exit code.",
  },
};

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Matthew Paver",
    url: "https://matthewpaver.github.io/",
    sameAs: [
      "https://github.com/MatthewPaver",
      "https://www.linkedin.com/in/matthew-paver-534262166/",
    ],
    jobTitle: "Product engineer",
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Software projects by Matthew Paver",
    numberOfItems: apps.length,
    itemListElement: apps.map((app, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: app.data.title,
      url: new URL(appUrl(app), Astro.site).href,
    })),
  },
];
---

<SiteLayout
  title="Matthew Paver · Product engineer"
  description="Tools that put the evidence in front of the person who has to decide — board approvals, meeting follow-ups, AI releases."
  structuredData={structuredData}
>
  <section class="promise-intro shell">
    <p class="kicker">Matthew Paver · Product engineer, London</p>
    <h1>Check the evidence before you approve, send or ship.</h1>
    <p class="promise-lede">
      High-stakes calls — a board approval, a meeting follow-up, an AI release —
      go wrong when the person deciding cannot see the evidence. I build tools
      that put it in front of them, and leave the decision human.
    </p>
    <div class="intro-actions">
      <a class="button button--primary button--large" href="https://matthewpaver.github.io/ProjectLens/change-assurance.html">
        Review a change pack in your browser
      </a>
      <a class="button button--secondary button--large" href="#work">See the three situations</a>
    </div>
    <ul class="evidence-chips" aria-label="Evidence behind the work">
      <li><strong>189</strong> UK major projects analysed <span>ProjectLens</span></li>
      <li><strong>30/30</strong> extraction eval cases pass <span>MeetingProof</span></li>
      <li><strong>369</strong> tests run in CI <span>Paper Trading</span></li>
      <li><strong>167</strong>-test reliability suite <span>Happening</span></li>
    </ul>
  </section>

  <section id="work" class="selected-work">
    <div class="shell">
      <header class="portfolio-section-heading">
        <div>
          <p class="kicker">Three situations</p>
          <h2>Start with the decision in front of you.</h2>
        </div>
        <p>Each one opens a working public example — synthetic data, no sign-up, limits stated.</p>
      </header>

      <div class="featured-projects">
        {featuredApps.map((app, index) => {
          const data = app.data;
          const detailUrl = appUrl(app);
          const demoUrl = data.launch ?? data.repo ?? detailUrl;
          const situation = situations[app.id];
          return (
            <article
              class:list={["featured-project", index === 0 && "featured-project--lead"]}
              data-portfolio-entry
            >
              <a class="featured-project-media" href={demoUrl} aria-label={`Open ${data.title}`}>
                <picture>
                  {data.imageAvif && <source srcset={data.imageAvif} type="image/avif" />}
                  <img
                    src={data.image}
                    alt={data.imageAlt}
                    width="1200"
                    height="675"
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                  />
                </picture>
              </a>
              <div class="featured-project-copy">
                <p class="project-label">0{index + 1} / {data.category}</p>
                <p class="situation-prompt">{situation.prompt}</p>
                <h3><a href={detailUrl}>{data.title}</a></h3>
                <p><strong>You finish with:</strong> {situation.finish}</p>
                <div class="project-links">
                  <a href={demoUrl}>Open the demo <span aria-hidden="true">↗</span></a>
                  <a href={detailUrl}>How it works</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <aside class="journey-close" aria-label="After the demo">
        <p><strong>Tried one?</strong> Next: inspect the source on <a href="https://github.com/MatthewPaver">GitHub</a>, read the build notes behind each demo, or <a href="https://www.linkedin.com/in/matthew-paver-534262166/">say hello on LinkedIn</a>.</p>
      </aside>
    </div>
  </section>

  <section id="more-work" class="more-work">
    <div class="shell">
      <header class="portfolio-section-heading">
        <div>
          <p class="kicker">Supporting work</p>
          <h2>Five builds behind the same pattern.</h2>
        </div>
        <p>Source material in, explicit checks, visible evidence, a person decides.</p>
      </header>

      <div class="product-grid">
        {supportingApps.map((app) => <AppCard app={app} />)}
      </div>

      <div class="listed-work">
        <p class="kicker">Also built</p>
        <ul>
          {listedApps.map((app) => (
            <li>
              <a href={appUrl(app)}>{app.data.shortTitle ?? app.data.title}</a>
              <span>{app.data.category.toLowerCase()}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="deploy-gate">
    <div class="shell">
      <header class="portfolio-section-heading">
        <div>
          <p class="kicker">Same rules for this site</p>
          <h2>Every push runs the checklist.</h2>
        </div>
        <p>This portfolio gates its own deploys the way the tools gate decisions — nothing ships unless the checks pass.</p>
      </header>
      <ul class="gate-checklist">
        <li><strong>Catalogue policy</strong><span>public entries must carry live repository evidence; private ones must declare themselves</span></li>
        <li><strong>Type check &amp; build</strong><span>astro check + full static build</span></li>
        <li><strong>Nine browser checks</strong><span>desktop and mobile Playwright runs, including no-JavaScript and overflow tests</span></li>
        <li><strong>Fresh repo evidence</strong><span>version and CI status on every card re-fetched from GitHub at deploy time</span></li>
      </ul>
      <p class="gate-link"><a href="https://github.com/MatthewPaver/MatthewPaver.github.io/blob/main/.github/workflows/pages.yml">Read the workflow <span aria-hidden="true">↗</span></a></p>
    </div>
  </section>

  <section id="about" class="portfolio-about shell">
    <p class="kicker">About</p>
    <div>
      <h2>A bit about me</h2>
      <p>
        I work across product design, software, data and automation in London.
        Most of these projects started because I wanted to understand a problem
        by building the tool myself. The code, tests and known limits are in the
        linked repositories.
      </p>
      <p class="about-certs">
        Certified: AWS Cloud Practitioner &amp; AI Practitioner · Neo4j Professional ·
        Hugging Face AI Agents · UiPath RPA · BCS Diploma in IT — verification in the CV.
      </p>
      <nav class="portfolio-links" aria-label="Contact Matthew Paver">
        <a href="https://www.linkedin.com/in/matthew-paver-534262166/">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/MatthewPaver">GitHub <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/MatthewPaver/MatthewPaver/blob/main/CV.pdf">CV (PDF) <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </section>
</SiteLayout>
