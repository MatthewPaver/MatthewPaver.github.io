---
import { getCollection } from "astro:content";
import AppCard from "../components/AppCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { appUrl, sortApps } from "../lib/catalogue";

const apps = sortApps(await getCollection("apps"));
const liveApps = apps.filter((app) => app.data.status === "live").length;
const sourceProjects = apps.filter((app) => app.data.repo).length;
const caseStudies = apps.filter((app) => app.data.kind === "case-study").length;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Matthew Paver",
    url: "https://matthewpaver.github.io/",
    sameAs: [
      "https://github.com/MatthewPaver",
      "https://www.linkedin.com/in/matthew-paver-534262166/",
    ],
    jobTitle: "Software engineer and automation specialist",
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Software by Matthew Paver",
    numberOfItems: apps.length,
    itemListElement: apps.map((app, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: app.data.title,
      url: new URL(appUrl(app), Astro.site).href,
    })),
  },
];
---

<SiteLayout
  title="Matthew Paver · Software"
  description="Working software and product case studies by Matthew Paver across project delivery, operations, automation, applied AI and data."
  structuredData={structuredData}
>
  <section class="index-intro shell">
    <div>
      <p class="kicker">Matthew Paver / Software</p>
      <h1>Working software for projects, operations and research.</h1>
      <p class="index-lede">
        I design and build the products listed here. Each entry links to a browser app,
        source repository or documented private case.
      </p>
    </div>

    <aside class="maker-card" aria-label="About this catalogue">
      <div class="maker-identity">
        <span aria-hidden="true">MP</span>
        <div><strong>Matthew Paver</strong><small>Software engineer</small></div>
      </div>
      <dl>
        <div><dt>Entries</dt><dd>{String(apps.length).padStart(2, "0")}</dd></div>
        <div><dt>Live apps</dt><dd>{String(liveApps).padStart(2, "0")}</dd></div>
        <div><dt>Public repositories</dt><dd>{String(sourceProjects).padStart(2, "0")}</dd></div>
      </dl>
      <a href="https://github.com/MatthewPaver">GitHub profile <span aria-hidden="true">↗</span></a>
    </aside>
  </section>

  <section id="products" class="software-index">
    <div class="shell">
      <header class="index-header">
        <div>
          <p class="kicker">Catalogue</p>
          <h2>Software <span>{String(apps.length).padStart(2, "0")}</span></h2>
        </div>
        <p>Use the app, read the source or open the product notes.</p>
      </header>

      <div class="catalogue-tools enhanced" aria-label="Find and filter software">
        <label class="index-search">
          <span class="sr-only">Search products</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.4A7.75 7.75 0 1 1 3.5 11.25a7.75 7.75 0 0 1 15.5 0Z" /></svg>
          <input id="catalogue-search" type="search" placeholder="Search products" autocomplete="off" />
        </label>
        <div class="index-tabs" aria-label="Catalogue sections">
          <button type="button" data-facet="" aria-pressed="true">All <span>{apps.length}</span></button>
          <button type="button" data-facet="live" aria-pressed="false">Live <span>{liveApps}</span></button>
          <button type="button" data-facet="source" aria-pressed="false">Source <span>{sourceProjects}</span></button>
          <button type="button" data-facet="case-study" aria-pressed="false">Cases <span>{caseStudies}</span></button>
        </div>
      </div>

      <div class="result-line enhanced" aria-live="polite">
        <span id="result-count">{apps.length} results</span>
        <button id="clear-filters" type="button">Reset</button>
      </div>

      <div class="product-grid" data-catalogue>
        {apps.map((app, index) => <AppCard app={app} priority={index < 3} />)}
      </div>

      <div id="catalogue-empty" class="empty-state enhanced" hidden>
        <strong>No matching software</strong>
        <p>Try the product name, a problem or a technology.</p>
      </div>
    </div>
  </section>

  <section id="about" class="about-strip shell">
    <div>
      <span class="owner-mark owner-mark--large" aria-hidden="true">MP</span>
      <div><p class="kicker">Built and maintained by</p><h2>Matthew Paver</h2></div>
    </div>
    <p>I work on project systems, operational software, automation and applied AI.</p>
    <nav aria-label="Matthew Paver links">
      <a href="https://github.com/MatthewPaver">GitHub ↗</a>
      <a href="https://www.linkedin.com/in/matthew-paver-534262166/">LinkedIn ↗</a>
    </nav>
  </section>

  <script>
    import { initCatalogue } from "../scripts/catalogue-state.mjs";
    initCatalogue();
  </script>
</SiteLayout>
