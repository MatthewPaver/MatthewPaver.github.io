---
import { getCollection } from "astro:content";
import AppCard from "../components/AppCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { appUrl, sortApps } from "../lib/catalogue";

const apps = sortApps(await getCollection("apps"));
const featuredApps = apps.filter((app) => app.data.featured);
const catalogueApps = apps.filter((app) => !app.data.featured);

const liveCount = apps.filter((app) => app.data.launch).length;
const publicRepoCount = apps.filter((app) => app.data.repo).length;

const shelves: { key: string; label: string }[] = [
  { key: "all", label: "All" },
  { key: "product", label: "Products" },
  { key: "data-ml", label: "Data & ML" },
  { key: "analytics", label: "Analytics" },
  { key: "automation", label: "Automation" },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Matthew Paver",
    url: "https://matthewpaver.github.io/",
    sameAs: [
      "https://github.com/MatthewPaver",
      "https://www.linkedin.com/in/matthew-paver-534262166/",
    ],
    jobTitle: "Product engineer",
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Software projects by Matthew Paver",
    numberOfItems: apps.length,
    itemListElement: apps.map((app, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: app.data.title,
      url: new URL(appUrl(app), Astro.site).href,
    })),
  },
];
---

<SiteLayout
  title="Matthew Paver · Software and AI engineering"
  description="Public decision tools, data products and reproducible engineering case studies by Matthew Paver."
  structuredData={structuredData}
>
  <section class="promise-intro shell">
    <p class="kicker">Matthew Paver · Product engineer, London</p>
    <h1>I build decision tools, data products and the checks that keep them honest.</h1>
    <p class="promise-lede">
      Seven public projects with working demos or reproducible run paths. Each one
      names the decision it supports, the evidence in the repository and its limits.
    </p>
    <div class="intro-actions">
      <a class="button button--primary button--large" href="#catalogue">Browse the shelves</a>
      <a class="button button--secondary button--large" href="https://www.linkedin.com/in/matthew-paver-534262166/">Connect with me</a>
    </div>
    <ul class="evidence-chips" aria-label="Catalogue in numbers">
      <li><strong>{apps.length}</strong> public projects <span>curated here</span></li>
      <li><strong>{liveCount}</strong> live demos <span>no sign-up</span></li>
      <li><strong>{publicRepoCount}</strong> public repos <span>on GitHub</span></li>
      <li><strong>23</strong> IAM benchmark cases <span>PolicyLens</span></li>
      <li><strong>13</strong> pipeline checks <span>ML Lakehouse</span></li>
    </ul>
  </section>

  <section id="work" class="selected-work">
    <div class="shell">
      <header class="portfolio-section-heading">
        <div>
          <p class="kicker">Open these first</p>
          <h2>Three projects worth a real look.</h2>
        </div>
        <p>Policy review, project change assurance and a three-sided booking journey.</p>
      </header>

      <div class="featured-projects">
        {featuredApps.map((app, index) => {
          const data = app.data;
          const detailUrl = appUrl(app);
          const demoUrl = data.launch ?? data.repo ?? detailUrl;
          const actionLabel = data.launch ? "Open demo" : data.repo ? "View source" : "Read case study";
          return (
            <article
              class:list={["featured-project", index === 0 && "featured-project--lead"]}
              data-portfolio-entry
            >
              <a class="featured-project-media" href={demoUrl} aria-label={`Open ${data.title}`}>
                <picture>
                  {data.imageAvif && <source srcset={data.imageAvif} type="image/avif" />}
                  <img
                    src={data.image}
                    alt={data.imageAlt}
                    width="1200"
                    height="675"
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                  />
                </picture>
              </a>
              <div class="featured-project-copy">
                <p class="project-label">0{index + 1} / {data.category}</p>
                <h3><a href={detailUrl}>{data.title}</a></h3>
                <p>{data.tagline}</p>
                <p><strong>You finish with:</strong> {data.outcome}</p>
                <div class="project-links">
                  <a href={demoUrl}>{actionLabel} <span aria-hidden="true">↗</span></a>
                  <a href={detailUrl}>How it works</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section id="catalogue" class="more-work">
    <div class="shell">
      <header class="portfolio-section-heading">
        <div>
          <p class="kicker">Catalogue</p>
          <h2>More public work.</h2>
        </div>
        <p>Decision tools, data templates, analytics handoffs and one finished experiment.</p>
      </header>

      <div class="catalogue-controls" data-catalogue-controls hidden>
        <input
          type="search"
          class="catalogue-search"
          placeholder="Search projects, stacks…"
          aria-label="Search projects"
          data-catalogue-search
        />
        <div class="shelf-filters" role="group" aria-label="Filter by shelf">
          {shelves.map((shelf, index) => (
            <button
              type="button"
              class:list={["shelf-filter", index === 0 && "is-active"]}
              data-shelf-filter={shelf.key}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {shelf.label}
            </button>
          ))}
        </div>
        <p class="catalogue-count" data-catalogue-count aria-live="polite"></p>
      </div>

      <div class="product-grid" data-catalogue-grid>
        {catalogueApps.map((app) => <AppCard app={app} />)}
      </div>
      <p class="catalogue-empty" data-catalogue-empty hidden>No projects match. Clear the search or pick another shelf.</p>
    </div>
  </section>

  <section class="deploy-gate">
    <div class="shell">
      <header class="portfolio-section-heading">
        <div>
          <p class="kicker">Same rules for this site</p>
          <h2>Every push runs the checklist.</h2>
        </div>
        <p>This site checks every catalogue entry before it deploys.</p>
      </header>
      <ul class="gate-checklist">
        <li><strong>Catalogue policy</strong><span>every visible project must link to a public repository and real screenshot</span></li>
        <li><strong>Type check &amp; build</strong><span>astro check + full static build</span></li>
        <li><strong>Nine browser checks</strong><span>desktop and mobile Playwright runs, including no-JavaScript and overflow tests</span></li>
        <li><strong>Fresh repo evidence</strong><span>version and CI status on every card re-fetched from GitHub at deploy time</span></li>
      </ul>
      <p class="gate-link"><a href="https://github.com/MatthewPaver/MatthewPaver.github.io/blob/main/.github/workflows/pages.yml">Read the workflow <span aria-hidden="true">↗</span></a></p>
    </div>
  </section>

  <section id="about" class="portfolio-about shell">
    <p class="kicker">About</p>
    <div>
      <h2>A bit about me</h2>
      <p>
        I work across product design, software, data and automation in London.
        These projects started with a specific question I wanted to answer by
        building the tool. The code, tests and known limits are in the
        linked repositories.
      </p>
      <p class="about-certs">
        Certified: AWS Cloud Practitioner &amp; AI Practitioner · Neo4j Professional ·
        Hugging Face AI Agents · UiPath RPA · BCS Diploma in IT. Verification is in the CV.
      </p>
      <nav class="portfolio-links" aria-label="Contact Matthew Paver">
        <a href="https://www.linkedin.com/in/matthew-paver-534262166/">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/MatthewPaver">GitHub <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/MatthewPaver/MatthewPaver/blob/main/CV.pdf">CV (PDF) <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </section>
</SiteLayout>

<script>
  const controls = document.querySelector<HTMLElement>("[data-catalogue-controls]");
  const grid = document.querySelector<HTMLElement>("[data-catalogue-grid]");
  if (controls && grid) {
    controls.hidden = false;
    const cards = [...grid.querySelectorAll<HTMLElement>(".product-card")];
    const search = controls.querySelector<HTMLInputElement>("[data-catalogue-search]");
    const filters = [...controls.querySelectorAll<HTMLButtonElement>("[data-shelf-filter]")];
    const count = controls.querySelector<HTMLElement>("[data-catalogue-count]");
    const empty = document.querySelector<HTMLElement>("[data-catalogue-empty]");
    let shelf = "all";

    const apply = () => {
      const query = (search?.value ?? "").trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const matchesShelf = shelf === "all" || card.dataset.shelf === shelf;
        const matchesQuery = !query || (card.textContent ?? "").toLowerCase().includes(query);
        const show = matchesShelf && matchesQuery;
        card.hidden = !show;
        if (show) shown += 1;
      }
      if (count) count.textContent = `${shown} of ${cards.length} projects showing`;
      if (empty) empty.hidden = shown > 0;
    };

    search?.addEventListener("input", apply);
    for (const button of filters) {
      button.addEventListener("click", () => {
        shelf = button.dataset.shelfFilter ?? "all";
        for (const other of filters) {
          const active = other === button;
          other.classList.toggle("is-active", active);
          other.setAttribute("aria-pressed", active ? "true" : "false");
        }
        apply();
      });
    }
    apply();
  }
</script>
