---
import { getCollection, render, type CollectionEntry } from "astro:content";
import AppIcon from "../../../components/AppIcon.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { appUrl, displayDate, metricFor } from "../../../lib/catalogue";

export async function getStaticPaths() {
  const apps = await getCollection("apps");
  return apps.map((app) => ({ params: { slug: app.id }, props: { app } }));
}

interface Props {
  app: CollectionEntry<"apps">;
}

const { app } = Astro.props;
const { Content } = await render(app);
const data = app.data;
const metric = metricFor(app);
const primaryUrl = data.launch ?? data.repo ?? data.caseStudy;
const statusLabel = {
  live: "Live app",
  public: "Open source",
  prototype: "Prototype",
  private: data.kind === "case-study" ? "Protected case study" : "Private product",
}[data.status];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: data.title,
    description: data.tagline,
    applicationCategory: data.category,
    operatingSystem: data.launch ? "Web" : "macOS, Windows, Linux",
    url: new URL(appUrl(app), Astro.site).href,
    image: new URL(data.image, Astro.site).href,
    codeRepository: data.repo,
    softwareVersion: data.version,
    license: data.license,
    author: { "@type": "Person", name: "Matthew Paver" },
    offers: data.kind === "flagship" ? { "@type": "Offer", price: "0", priceCurrency: "GBP" } : undefined,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Selected software", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: data.title, item: new URL(appUrl(app), Astro.site).href },
    ],
  },
];
---

<SiteLayout
  title={`${data.title} · Matthew Paver`}
  description={data.tagline}
  image={data.image}
  canonical={appUrl(app)}
  structuredData={structuredData}
>
  <div class="shell app-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Selected software</a><span aria-hidden="true">/</span><span>{data.title}</span>
    </nav>

    <header class="app-hero">
      <div class="app-hero-copy">
        <div class="detail-identity">
          <AppIcon slug={app.id} />
          <div>
            <p class="kicker">{data.portfolioRole}</p>
            <h1>{data.title}</h1>
          </div>
        </div>
        <p class="app-hero-lede">{data.tagline}</p>
        <div class="detail-status">
          <span class:list={["availability", `availability--${data.status}`]}>{statusLabel}</span>
          {metric?.ciStatus === "success" && <span>Automated checks pass</span>}
          {metric?.ciStatus === "failure" && <span>Automated checks need attention</span>}
        </div>
        <div class="app-hero-actions">
          {primaryUrl && <a class="button button--primary button--large" href={primaryUrl}>{data.primaryAction}</a>}
          {data.repo && <a class="button button--secondary button--large" href={data.repo}>View source</a>}
          {data.repo && metric?.release && (
            <a class="button button--secondary button--large" href={`${data.repo}/releases/latest`}>
              Download {metric.release}
            </a>
          )}
        </div>
        <dl class="app-facts">
          <div><dt>Built for</dt><dd>{data.audience}</dd></div>
          <div><dt>Version</dt><dd>{metric?.release ?? data.version}</dd></div>
          <div><dt>Licence</dt><dd>{data.license}</dd></div>
        </dl>
      </div>
      <figure class="app-hero-media">
        <picture>
          {data.imageAvif && <source srcset={data.imageAvif} type="image/avif" />}
          <img src={data.image} alt={data.imageAlt} width="1200" height="675" fetchpriority="high" />
        </picture>
        <figcaption>Current interface or product preview.</figcaption>
      </figure>
    </header>

    <nav class="page-tabs" aria-label="On this page">
      <a href="#overview">Overview</a>
      <a href="#evidence">Included</a>
      <a href={data.install.length ? "#install" : "#boundary"}>{data.install.length ? "Install" : "About the case"}</a>
      <a href="#status">Status</a>
    </nav>

    <div class="app-content-grid">
      <div class="app-content-main">
        <section id="overview" class="detail-section">
          <p class="kicker">Overview</p>
          <h2>{data.problem}</h2>
          <p class="outcome">{data.outcome}</p>
          <div class="prose"><Content /></div>
        </section>

        <section id="evidence" class="detail-section">
          <p class="kicker">Included</p>
          <h2>What this version contains</h2>
          <ul class="evidence-grid">
            {data.proof.map((proof, index) => (
              <li><span>0{index + 1}</span><strong>{proof}</strong></li>
            ))}
          </ul>
          <ul class="stack-list stack-list--large" aria-label="Technology">
            {data.stack.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        {data.install.length > 0 ? (
          <section id="install" class="detail-section">
            <p class="kicker">Install</p>
            <h2>Run it locally</h2>
            <p class="outcome">Clone the repository and run the commands below.</p>
            {data.requirements.length > 0 && (
              <div class="requirements">
                <h3>Requirements</h3>
                <ul>{data.requirements.map((item) => <li>{item}</li>)}</ul>
              </div>
            )}
            <div class="command-stack">
              {data.install.map((command) => (
                <div class="command-line">
                  <code>{command}</code>
                  <button type="button" data-copy={command}>Copy</button>
                </div>
              ))}
            </div>
            {data.validate.length > 0 && (
              <div class="validate-block">
                <h3>Verify it</h3>
                {data.validate.map((command) => (
                  <div class="command-line">
                    <code>{command}</code>
                    <button type="button" data-copy={command}>Copy</button>
                  </div>
                ))}
              </div>
            )}
          </section>
        ) : (
          <section id="boundary" class="detail-section">
            <p class="kicker">Private product</p>
            <h2>{data.kind === "case-study" ? "Public case study" : "Private product"}</h2>
            <p class="outcome">
              {data.kind === "case-study"
                ? "The product notes are public. Source code, customer data and operating procedures remain private."
                : "The overview documents the working product while its source code and account-backed services remain private."}
            </p>
          </section>
        )}

        <section id="status" class="detail-section">
          <p class="kicker">Current status</p>
          <h2>Known limits</h2>
          <ul class="limitations">
            {data.limitations.map((item) => <li>{item}</li>)}
          </ul>
          <p class="status-note">
            Last reviewed {displayDate(data.updated)}. Portfolio metadata is generated from the same content entry as this page.
          </p>
        </section>
      </div>

      <aside class="app-content-aside">
        <div class="aside-panel">
          <p class="kicker">Open</p>
          <strong>{data.primaryAction}</strong>
          <p>{data.tagline}</p>
          {primaryUrl && <a class="button button--primary" href={primaryUrl}>Continue</a>}
          {data.repo && metric?.release && (
            <a class="text-link" href={`${data.repo}/releases/latest`}>Release {metric.release} <span aria-hidden="true">→</span></a>
          )}
        </div>
        <div class="aside-panel">
          <p class="kicker">Technology</p>
          <ul>{data.stack.map((item) => <li>{item}</li>)}</ul>
        </div>
      </aside>
    </div>
  </div>

  <script>
    import { initCopyButtons } from "../../../scripts/copy-buttons.mjs";
    initCopyButtons();
  </script>
</SiteLayout>
